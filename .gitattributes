# 默认统一为 LF（Python / Markdown / 模板）
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则 if/for 多行结构会被解析错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制，不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.exe binary
*.db binary
